{
  "kind": "collectionType",
  "collectionName": "partner",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "partner"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "partnerType": {
      "type": "enumeration",
      "enum": [
        "technology",
        "implementation",
        "referral",
        "reseller",
        "consultant"
      ],
      "default": "technology"
    },
    "website": {
      "type": "string",
      "required": false
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "description": {
      "type": "text"
    }
  }
}
