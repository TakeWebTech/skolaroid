{
  "kind": "collectionType",
  "collectionName": "case_study",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "case study"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer"
    },
    "challenge": {
      "type": "richtext"
    },
    "solution": {
      "type": "richtext"
    },
    "results": {
      "type": "richtext"
    },
    "modulesUsed": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product-module.product-module"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
