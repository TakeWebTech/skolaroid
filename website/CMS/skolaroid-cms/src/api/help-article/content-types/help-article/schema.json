{
  "kind": "collectionType",
  "collectionName": "help_article",
  "info": {
    "singularName": "help-article",
    "pluralName": "help-articles",
    "displayName": "help article"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "body": {
      "type": "richtext"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::help-category.help-category"
    },
    "order": {
      "type": "integer"
    }
  }
}
