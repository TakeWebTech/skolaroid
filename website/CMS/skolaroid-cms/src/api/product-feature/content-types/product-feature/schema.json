{
  "kind": "collectionType",
  "collectionName": "product_feature",
  "info": {
    "singularName": "product-feature",
    "pluralName": "product-features",
    "displayName": "product feature"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "availabilityStatus": {
      "type": "enumeration",
      "enum": [
        "available",
        "beta",
        "planned",
        "custom"
      ],
      "default": "planned"
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-module.product-module"
    },
    "details": {
      "type": "richtext"
    },
    "order": {
      "type": "integer"
    }
  }
}
